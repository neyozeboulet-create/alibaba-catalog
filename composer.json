{
  "name": "neyozeboulet-create/alibaba-catalog",
  "description": "Catalogue de produits importés Alibaba - PHP/MySQL",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-gd": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "composer/*": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "includes/"
    },
    "files": [
      "config/bootstrap.php",
      "includes/functions.php"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"chmod('assets', 0755); chmod('admin', 0755); chmod('api', 0755); chmod('config', 0755); chmod('includes', 0755);\""
    ],
    "post-update-cmd": [
      "@php -r \"chmod('assets', 0755); chmod('admin', 0755); chmod('api', 0755); chmod('config', 0755); chmod('includes', 0755);\""
    ],
    "test": [
      "phpstan analyse includes/ config/ --level=5",
      "php-cs-fixer fix --dry-run --diff"
    ],
    "cs-fix": [
      "php-cs-fixer fix"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  }
}