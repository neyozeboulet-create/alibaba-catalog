{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "nixpkgs": ["php82", "php82Extensions.pdo_mysql", "php82Extensions.mbstring"],
      "cmd": "php -S 0.0.0.0:$PORT -t ."
    }
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheck": {
      "path": "/",
      "interval": 60,
      "timeout": 10
    }
  }
}